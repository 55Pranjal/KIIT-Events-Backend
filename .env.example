# =============================================================================
# Server environment template — copy this file to `server/.env` and fill in.
# Never commit the real .env. All variables are required unless marked OPTIONAL.
# =============================================================================

# --- Core ---
# Long, random, secret string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# MongoDB connection string. Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/<db>
MONGO_URI=

# OPTIONAL. Defaults to 5000.
PORT=5000

# OPTIONAL. Set to "production" on the deployed server, "development" locally.
NODE_ENV=development

# --- Google OAuth (sign-in) ---
# Web Client ID from Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID=

# Email domain users must sign in with. Defaults to kiit.ac.in if unset.
ALLOWED_EMAIL_DOMAIN=kiit.ac.in

# Comma-separated whitelist of emails that automatically get role=admin on
# first Google sign-in. Bootstraps the first admin account.
#   e.g. ADMIN_EMAIL_WHITELIST=you@kiit.ac.in,co-admin@kiit.ac.in
ADMIN_EMAIL_WHITELIST=

# --- CORS ---
# Comma-separated list of allowed frontend origins in production.
# Local dev origins (localhost:5173, localhost:4173) are always allowed.
#   e.g. ALLOWED_ORIGINS=https://kiitevents.netlify.app,https://kiitevents.com
ALLOWED_ORIGINS=

# --- Cloudinary (poster uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

